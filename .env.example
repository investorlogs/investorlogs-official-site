# Database
DATABASE_URL="postgresql://username:password@localhost:5432/investorlogs_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# ---------------------------------------------------------------------------
# XclusivePlugs supplier API (reseller / middleman for digital accounts logs)
#
# Docs:     https://xclusiveplugs.com/api-docs/logs
# Base URL: https://xclusiveplugs.com/api/v1
# Auth:     Authorization: Bearer <XCLUSIVE_PLUGS_API_KEY>
#
# Get your API key from https://app.xclusiveplugs.com/user/change-password#api-access
#
# config/productMap.json maps our internal slugs to supplier category IDs.
# Edit that file to match the IDs returned by the supplier.
# ---------------------------------------------------------------------------

XCLUSIVE_PLUGS_API_URL="https://xclusiveplugs.com/api/v1"
XCLUSIVE_PLUGS_API_KEY="your-bearer-token"
# Development only. See the DEVELOPMENT ONLY — MOCK PROVIDERS section below.
# XCLUSIVE_PLUGS_DEBUG="true"

# ---------------------------------------------------------------------------
# SMS Provider (5sim-compatible)
#
# Docs:     https://5sim.net/docs
# Base URL: https://5sim.net
# Auth:     Authorization: Bearer <SMS_PROVIDER_API_KEY>
# ---------------------------------------------------------------------------

SMS_PROVIDER_BASE_URL="https://5sim.net"
SMS_PROVIDER_API_KEY="your-sms-api-key"
# Development only. See the DEVELOPMENT ONLY — MOCK PROVIDERS section below.
# SMS_PROVIDER_MOCK="true"

# ---------------------------------------------------------------------------
# SMM Provider (Really Simple Social)
#
# Docs:     https://reallysimplesocial.com/api
# Base URL: https://reallysimplesocial.com/api/v2
# Auth:     key=<SMM_PROVIDER_API_KEY> (POST form param)
# ---------------------------------------------------------------------------

SMM_PROVIDER_BASE_URL="https://reallysimplesocial.com/api/v2"
SMM_PROVIDER_API_KEY="your-smm-api-key"
# Development only. See the DEVELOPMENT ONLY — MOCK PROVIDERS section below.
# SMM_PROVIDER_MOCK="true"

# Markup percentage added to provider rates (default 20%)
SMM_MARKUP_PERCENT="20"

# ===========================================================================
# DEVELOPMENT ONLY — MOCK PROVIDERS
#
# Every var below must be "false" or unset in production. Setting any of them
# to "true" while NODE_ENV=production makes the app throw on startup and the
# server will refuse to boot.
#
# Turning one on makes that module credit wallets or confirm payments without
# contacting a real gateway, so a production deploy with a mock flag on hands
# out free balance.
# ===========================================================================

# Use the in-process SMS provider instead of 5sim.
# SMS_PROVIDER_MOCK="true"

# Use the in-process SMM provider instead of Really Simple Social.
# SMM_PROVIDER_MOCK="true"

# Use the in-process payment provider instead of Paystack. Never "true" in
# production — it lets deposits settle without a real gateway charge.
# PAYMENT_PROVIDER_MOCK="true"

# ---------------------------------------------------------------------------
# Master switch for customer-facing deposits.
#
# DEFAULT: off (unset). While off:
#   - the wallet page shows "deposits coming soon" instead of the form
#   - POST /api/payments/initialize returns 503 DEPOSITS_DISABLED
#
# Safe to turn on once Paystack is configured below, because BOTH confirmation
# paths verify with the gateway and credit the wallet through one shared,
# idempotent settlement step:
#   - /api/payments/webhook   signed charge event from Paystack
#   - /api/payments/callback  the browser redirect after checkout; this one
#                             re-verifies the reference with Paystack
#                             server-side, because a customer can edit it
#
# Either path credits the balance at most once (a compare-and-swap on
# PENDING -> terminal), so a webhook and a callback racing each other is safe.
# Set PAYSTACK_WEBHOOK_SECRET below so the webhook signature is checked with
# Paystack's signing key rather than the API key.
# ---------------------------------------------------------------------------

# PAYMENTS_ENABLED="true"

# ---------------------------------------------------------------------------
# Paystack (card payments)
#
# Docs:     https://dashboard.paystack.com/#/settings/developers
# Base URL: https://api.paystack.co (override with PAYSTACK_BASE_URL)
# Auth:     Authorization: Bearer <PAYSTACK_SECRET_KEY>
#
# Use sk_test_... locally and sk_live_... only in production.
# NEVER commit the real key — it can move money and read customer data.
#
# REQUIRED IN PRODUCTION — leave blank here and fill in your own .env.
# A blank value is intentional: the app treats the placeholder shapes
# ("sk_test_xxx", "re_xxx", "your-") as unconfigured and refuses to start,
# so an unfilled template fails fast instead of calling the live gateway.
# ---------------------------------------------------------------------------

PAYSTACK_BASE_URL="https://api.paystack.co"
PAYSTACK_SECRET_KEY=
# Development only. See the DEVELOPMENT ONLY — MOCK PROVIDERS section below.
# PAYMENT_PROVIDER_MOCK="true"

# Optional: defaults to the Paystack webhook secret from your dashboard
# PAYSTACK_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email (Resend) — powers password-reset links and transactional mail.
#
# Docs:     https://resend.com/api-keys
# Base URL: https://api.resend.com
# Auth:     Authorization: Bearer <RESEND_API_KEY>
#
# Sign up: https://resend.com  (free: 100 emails/day, 3,000/mo)
# From address: verify in the Resend dashboard, e.g. noreply@yourdomain.com
# Without these vars, reset links are logged to the console in dev and the
# flow is a no-op in production (users get a generic "we sent a link" message).
# Leave RESEND_API_KEY blank here and fill in your own .env.
# ---------------------------------------------------------------------------

RESEND_API_KEY=
RESEND_FROM_EMAIL="noreply@investorplugx.com"

# ---------------------------------------------------------------------------
# AI customer care (OpenAI) — powers the in-site support assistant.
#
# Docs:     https://platform.openai.com/api-keys
# Base URL: https://api.openai.com/v1
# Auth:     Authorization: Bearer <OPENAI_API_KEY>
#
# Without this var the assistant shows an offline self-service checklist.
# Leave blank here and fill in your own .env.
# ---------------------------------------------------------------------------

OPENAI_API_KEY=

