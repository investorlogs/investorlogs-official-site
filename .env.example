# Database
DATABASE_URL="postgresql://username:password@localhost:5432/investorlogs_db?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# ---------------------------------------------------------------------------
# XclusivePlugs supplier API (reseller / middleman for digital accounts logs)
#
# Base URL: https://xclusiveplugs.com/api/v1
# Auth:     Authorization: Bearer <XCLUSIVE_PLUGS_API_KEY>
#
# Get your API key from https://app.xclusiveplugs.com/user/change-password#api-access
# Find log category IDs at https://xclusiveplugs.com/api-docs/logs
#
# config/productMap.json maps our internal slugs to supplier category IDs.
# Edit that file to match the IDs returned by the supplier.
# ---------------------------------------------------------------------------

XCLUSIVE_PLUGS_API_URL="https://xclusiveplugs.com/api/v1"
XCLUSIVE_PLUGS_API_KEY="your-bearer-token"
# Set to "true" to print verbose [xclusivePlugs] request logs
# XCLUSIVE_PLUGS_DEBUG="true"

# ---------------------------------------------------------------------------
# SMS Provider (5sim-compatible)
#
# Base URL: https://5sim.net
# Auth:     Authorization: Bearer <SMS_PROVIDER_API_KEY>
# ---------------------------------------------------------------------------

SMS_PROVIDER_BASE_URL="https://5sim.net"
SMS_PROVIDER_API_KEY="your-sms-api-key"
# Set to "true" to use the mock provider in development
# SMS_PROVIDER_MOCK="true"

# ---------------------------------------------------------------------------
# SMM Provider (Really Simple Social)
#
# Base URL: https://reallysimplesocial.com/api/v2
# Auth:     key=<SMM_PROVIDER_API_KEY> (POST form param)
#
# Get your API key from https://reallysimplesocial.com/api
# ---------------------------------------------------------------------------

SMM_PROVIDER_BASE_URL="https://reallysimplesocial.com/api/v2"
SMM_PROVIDER_API_KEY="your-smm-api-key"
# Set to "true" to use the mock provider in development
# SMM_PROVIDER_MOCK="true"
# Markup percentage added to provider rates (default 20%)
SMM_MARKUP_PERCENT="20"
