# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.production

# prisma
/src/generated

# agent skill files (auto-generated by `prisma skills sync` on postinstall)
/.agents/
/.claude/
/.cursor/
/.devin/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev server output
/dev-server.log
/dev-server.err.log
# pm2 runtime logs
/logs
.pm2/

# local scratch output from tooling (regenerable, not part of the project)
/.codex-typecheck.log
/.next-dev-local.*.log
/.tmp-review-*.diff
/build-out.txt
/diff-config.txt
/git-status.txt
/prisma-out.txt
/prisma-validate.txt
/probe1.txt
/typecheck-full.log
/typecheck-out.txt
/t.txt
/tc*.txt
/d[0-9].txt